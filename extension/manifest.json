{
  "manifest_version": 3,
  "name": "Webverse",
  "version": "0.1.0",
  "description": "Riscrivi CSS e comportamento dei siti parlando con un assistente AI locale (claude -p).",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "userScripts", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Webverse: mostra/nascondi assistente" },
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Mostra/nascondi Webverse"
    }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["icons.js", "markdown.js", "content.js"], "run_at": "document_idle" }
  ]
}
